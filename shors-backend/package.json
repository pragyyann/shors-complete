{
  "name": "shors-backend",
  "version": "1.0.0",
  "description": "Backend API for SHORS",
  "private": true,
  "type": "module",

  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",

    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",

    "seed": "tsx prisma/seed.ts",

    "lint": "tsc --noEmit"
  },

  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },

  "keywords": [
    "express",
    "typescript",
    "prisma",
    "mysql",
    "shors"
  ],

  "author": "",
  "license": "ISC",

  "dependencies": {
    "@prisma/client": "^6.15.0",

    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.0",
    "prisma": "^6.15.0",
    "slugify": "^1.6.6",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },

  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.28",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",

    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}